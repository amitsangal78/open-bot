{
  "name": "open-bot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names web,worker \"npm:dev:web\" \"npm:dev:worker\"",
    "build": "next build",
    "start": "concurrently --kill-others --names web,worker \"npm:start:web\" \"npm:start:worker\"",
    "lint": "eslint",
    "predev": "npm run db:migrate",
    "dev:web": "next dev --hostname 127.0.0.1",
    "dev:worker": "node --env-file-if-exists=.env.local --import tsx src/worker/index.ts",
    "prestart": "npm run db:migrate",
    "start:web": "next start --hostname 127.0.0.1",
    "start:worker": "node --env-file-if-exists=.env.local --import tsx src/worker/index.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:webpack": "next build --webpack",
    "dev:all": "node scripts/dev-all.mjs"
  },
  "dependencies": {
    "@langchain/core": "^1.3.4",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.6.0",
    "@langchain/xai": "^1.5.2",
    "@radix-ui/react-slot": "^1.5.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.4",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.4",
    "googleapis": "^189.0.0",
    "ipaddr.js": "^2.5.0",
    "js-tiktoken": "^1.0.21",
    "lucide-react": "^1.70.0",
    "next": "^16.4.6",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "yahoo-finance2": "^4.0.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "22.x"
  }
}
